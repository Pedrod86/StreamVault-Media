{
  "name": "VpnServer",
  "type": "object",
  "properties": {
    "vpn_type": {
      "type": "string",
      "enum": [
        "wireguard",
        "openvpn"
      ],
      "default": "wireguard",
      "description": "VPN protocol \u2014 WireGuard or OpenVPN"
    },
    "provider_name": {
      "type": "string",
      "description": "Display name for this VPN server entry (e.g. 'London - WireGuard')"
    },
    "endpoint_host": {
      "type": "string",
      "description": "VPN endpoint host or IP (WireGuard endpoint or OpenVPN remote)"
    },
    "endpoint_port": {
      "type": "number",
      "description": "VPN endpoint UDP/TCP port",
      "default": 51820
    },
    "protocol": {
      "type": "string",
      "enum": [
        "udp",
        "tcp"
      ],
      "default": "udp",
      "description": "OpenVPN transport protocol (ignored for WireGuard)"
    },
    "address": {
      "type": "string",
      "description": "WireGuard internal tunnel IP (Interface.Address)"
    },
    "allowed_ips": {
      "type": "string",
      "description": "WireGuard Peer AllowedIPs",
      "default": "0.0.0.0/0, ::/0"
    },
    "dns": {
      "type": "string",
      "description": "DNS servers for the interface"
    },
    "private_key": {
      "type": "string",
      "description": "WireGuard private key (Interface.PrivateKey)"
    },
    "public_key": {
      "type": "string",
      "description": "Server's WireGuard public key (Peer.PublicKey)"
    },
    "pre_shared_key": {
      "type": "string",
      "description": "Optional WireGuard pre-shared key (Peer.PresharedKey)"
    },
    "ovpn_config": {
      "type": "string",
      "description": "Full OpenVPN .ovpn configuration file contents"
    },
    "username": {
      "type": "string",
      "description": "Account username from your VPN shop"
    },
    "password": {
      "type": "string",
      "description": "Account password from your VPN shop"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the currently selected server"
    }
  },
  "required": [
    "provider_name",
    "endpoint_host"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}